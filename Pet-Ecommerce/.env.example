SERVER_PORT=2424

DB_URL=jdbc:mysql://localhost:3306/ecommerce
DB_USERNAME=
DB_PASSWORD=
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
REFUND_RETURN_DAYS=7
REFUND_ENABLED=false

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAME_SITE=Lax

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE=5MB

SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000

# VNPay sandbox credentials from https://sandbox.vnpayment.vn/devreg/
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PENDING_MINUTES=15

# Free local demo with Ollama (implements /v1/embeddings and /v1/chat/completions)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_CHAT_MODEL=qwen2.5:3b-instruct
AI_EMBEDDING_MODEL=nomic-embed-text
AI_TOP_K=5
AI_MINIMUM_SCORE=0.2

# SMTP (set MAIL_ENABLED=true after completing SMTP settings)
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_MINUTES=15
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

AWS_S3_ACCESS=
AWS_S3_SECRET=
AWS_S3_BUCKET=petshop-ecommerce
AWS_S3_REGION=ap-southeast-2
